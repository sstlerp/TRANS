# ── TRANS ERP configuration (copy to .env; never commit real secrets) ──
ERP_ENV=production                      # development | test | production
ERP_APP_NAME=TRANS ERP
ERP_COMPANY_NAME=Your Transport Company
# MySQL 8.x / MariaDB 10.6+ (utf8mb4). Create the DB + user first (see README).
ERP_DATABASE_URL=mysql+pymysql://erp_user:CHANGE_ME@127.0.0.1:3306/ERP_LOGISTICS?charset=utf8mb4
ERP_DB_POOL_SIZE=10
# Long random value: python -c "import secrets; print(secrets.token_urlsafe(48))"
ERP_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
ERP_ACCESS_TOKEN_MINUTES=480
ERP_COOKIE_SECURE=true                  # true behind HTTPS
ERP_TIMEZONE=Asia/Kolkata
ERP_STORAGE_DIR=/var/lib/trans-erp/storage
ERP_LOG_DIR=/var/log/trans-erp
ERP_LOG_LEVEL=INFO
ERP_MAX_UPLOAD_MB=25
ERP_ASYNC_IMPORT_THRESHOLD=2000         # larger statements import in the background
ERP_LOGIN_RATE_LIMIT=10
ERP_LOGIN_RATE_WINDOW_SEC=300
# Initial admin password used by `python -m app.seed` (otherwise Admin@12345 + forced change)
ERP_ADMIN_PASSWORD=
# Optional SMTP for e-mail notifications
ERP_SMTP_HOST=
ERP_SMTP_PORT=587
ERP_SMTP_USER=
ERP_SMTP_PASSWORD=
ERP_SMTP_FROM=
# Integration credentials are referenced BY NAME from Administration → API Integrations, e.g.:
# ERP_FASTAG_API_KEY=
# Toll plaza master from data.gov.in (free key from https://data.gov.in) — see docs/INTEGRATIONS.md
# ERP_DATA_GOV_IN_API_KEY=
# Map background of Toll → Toll Plaza Directory & Map (default: OpenStreetMap standard tiles)
# ERP_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# ERP_MAP_ATTRIBUTION=© OpenStreetMap contributors
